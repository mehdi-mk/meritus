[ignore]
# Never let the agent read package managers or dependencies
node_modules/
vendor/
.venv/
env/
wheels/

# Block compiled binaries, build outputs, and caches
dist/
build/
.next/
.nuxt/
out/
__pycache__/
*.pyc

# Block massive media assets, system files, and local databases
*.mp4
*.png
*.jpg
*.svg
.DS_Store
*.db
*.sqlite3

# Block local logs and analytics files that update constantly
*.log
logs/
.analytics/

